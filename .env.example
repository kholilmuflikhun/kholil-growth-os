# Local development only. Copy to .env and replace all placeholder secrets.
# Never commit .env or put private values in NEXT_PUBLIC_* variables.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kholil_growth_os?schema=public
# Optional direct connection used for migrations when DATABASE_URL is a pooler URL.
DIRECT_URL=
DATABASE_POOL_MAX=5
AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CRON_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Public website (apps/web)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOS_URL=http://localhost:3001
GOS_API_URL=http://localhost:3001

# Set these two values to the same independently generated random secret.
# Keep both server-side only; do not prefix either with NEXT_PUBLIC_.
GOS_LEAD_API_SECRET=REPLACE_WITH_SHARED_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
PUBLIC_LEAD_API_SECRET=REPLACE_WITH_SHARED_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# One-time administrator bootstrap only. Use a unique strong password and remove
# BOOTSTRAP_ADMIN_PASSWORD from deployment configuration after the account exists.
BOOTSTRAP_ADMIN_USERNAME=Kholil
BOOTSTRAP_ADMIN_EMAIL=kholilmuflikhun@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_STRONG_PASSWORD

# Optional notification providers. Leave blank until configured and tested.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NOTIFICATION_EMAIL_TO=
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=

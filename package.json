{
  "name": "kholil-growth-os",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "node --import dotenv/config node_modules/turbo/bin/turbo dev",
    "build": "pnpm db:generate && node --import dotenv/config node_modules/turbo/bin/turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:migrate": "prisma migrate dev --config prisma7.config.ts",
    "db:seed": "tsx prisma/seed.ts",
    "admin:bootstrap": "tsx prisma/bootstrap-admin.ts",
    "db:deploy": "prisma migrate deploy --config prisma7.config.ts",
    "production:check": "node scripts/production-preflight.mjs",
    "production:check:strict": "node scripts/production-preflight.mjs --production",
    "qa": "pnpm db:generate && pnpm qa:static && pnpm test && pnpm typecheck && pnpm lint && pnpm build",
    "smoke": "node scripts/smoke-test.mjs",
    "format:check": "prettier --check .",
    "qa:static": "node scripts/static-checks.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "prisma": "7.10.0",
    "tsx": "4.20.6",
    "turbo": "2.11.2",
    "typescript": "5.9.3",
    "dotenv": "17.2.3",
    "bcryptjs": "3.0.3",
    "@prisma/client": "7.10.0",
    "prettier": "3.6.2",
    "@types/pg": "8.15.5",
    "@playwright/test": "1.64.1",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.2",
    "next": "16.4.2"
  },
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=12.7.0 <13"
  },
  "type": "module"
}

# Copy these values into each Vercel project's Environment Variables UI.
# Never commit actual values. Generate different random secrets for each environment.
DATABASE_URL=postgresql://postgres:27Juli1995@localhost:5432/kholil_growth_os?schema=public
AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CRON_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_GOS_URL=https://your-gos-domain.example
GOS_API_URL=https://your-gos-domain.example
# Set the same random secret in both Vercel projects (server-side only).
